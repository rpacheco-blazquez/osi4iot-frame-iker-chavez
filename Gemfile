source "https://rubygems.org"

# Gem de GitHub Pages que incluye Jekyll y plugins compatibles
gem "github-pages", group: :jekyll_plugins

# Plugins adicionales para mejorar la funcionalidad
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-github-metadata"
  gem "jekyll-relative-links"
end

# Dependencias del sistema
gem "webrick", "~> 1.7" # Requerido para Ruby 3.0+
gem "kramdown-parser-gfm" # Parser de GitHub Flavored Markdown

# Gemas de desarrollo (opcional)
group :development do
  gem "jekyll", "~> 3.9.0"
end